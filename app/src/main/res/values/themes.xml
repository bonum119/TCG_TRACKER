        <item name="android:windowBackground">@drawable/background</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant_dark</item>

        <item name="colorPrimary">@color/gray_primary</item>
        <item name="colorOnPrimary">#121212</item>
        <item name="colorPrimaryContainer">@color/surface_variant_dark</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/gray_secondary</item>
